# Kopieren nach .env und anpassen:  cp .env.example .env
# Danach einmalig:                  php artisan key:generate
#
# Umgebungsvariablen werden NUR in config/*.php gelesen. Im Anwendungscode
# steht immer config('…'), nie env('…') — nach `php artisan config:cache`
# (im Container passiert das beim Start) liefert env() sonst null.

# --- Anwendung ---------------------------------------------------------------
# Name in Seitentitel, Kopfzeile und unter dem Icon der installierten App.
APP_NAME="Cardbox"
# Kurzname fuer den Startbildschirm des Telefons (dort passen ~12 Zeichen).
APP_SHORT_NAME="Cardbox"
APP_ENV=local
APP_KEY=
# In Produktion MUSS das false sein — sonst sieht jeder Besucher Stacktraces
# samt Umgebungsvariablen.
APP_DEBUG=true
# Oeffentliche Adresse. Wird fuer Links in Mails und die Herkunftspruefung
# benutzt — in Produktion auf die echte https-Adresse setzen.
APP_URL=http://localhost:8001

APP_LOCALE=de
# Fehlt eine deutsche Uebersetzung, lieber Englisch als ein roher Schluessel.
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE

# Auf true setzen, wenn ein Reverse-Proxy (nginx, Traefik, Loadbalancer)
# davorsteht und X-Forwarded-For setzt. Nur dann wird diesem Kopf geglaubt.
# Ohne Proxy MUSS das false bleiben, sonst laesst sich die Anmeldebremse
# pro IP durch einen selbst gesetzten Kopf umgehen.
TRUST_PROXY=false

# --- Installierbare App (PWA) --------------------------------------------------
# Farben als #rgb oder #rrggbb. Leistenfarbe sollte zur Markenfarbe in
# resources/css/theme.css passen.
# Anfuehrungszeichen PFLICHT: Ohne sie liest .env das # als Kommentarbeginn,
# und der Wert ist leer. Der Start bricht dann mit einer Meldung ab.
PWA_THEME_COLOR="#3370c7"
PWA_BACKGROUND_COLOR="#f9fafc"

# --- Datenbank ---------------------------------------------------------------
# Externe PostgreSQL. Fuer die lokale Entwicklung startet `just db-up` einen
# Container, der genau zu diesen Zeilen passt.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=56433
DB_DATABASE=cardbox
DB_USERNAME=cardbox
DB_PASSWORD=cardbox
# PostgreSQL-Schema fuer alle Tabellen. Standard: public. Beim Hoster oft
# vorgegeben, wenn sich mehrere Anwendungen eine Datenbank teilen.
DB_SCHEMA=public
# In Produktion ueber ein Netz: require
DB_SSLMODE=prefer

# --- Sitzungen -----------------------------------------------------------------
# Sessions liegen in Postgres — mehrere Instanzen brauchen keine klebrigen Sitzungen.
SESSION_DRIVER=database
SESSION_LIFETIME=720
# In Produktion mit HTTPS auf true setzen: Das Session-Cookie wird dann nur
# noch verschluesselt uebertragen.
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
# Kein Queue-Worker noetig: Hintergrundarbeit laeuft ueber defer() nach der Antwort.
QUEUE_CONNECTION=sync

# Argon2id statt bcrypt.
HASH_DRIVER=argon2id

# --- E-Mail ------------------------------------------------------------------
# Lokal: `just mail-up` startet Mailpit, das alles abfaengt.
#        Ansehen unter http://localhost:59026
# Ohne Mailserver: MAIL_MAILER=log — Mails erscheinen dann nur im Log.
#
# Produktion, Beispiele:
#   MAIL_URL=smtps://benutzer:passwort@mail.example.com:465               (TLS)
#   MAIL_URL=smtp://benutzer:passwort@mail.example.com:587                (STARTTLS)
# Sonderzeichen im Passwort URL-kodieren: @ -> %40, : -> %3A, / -> %2F
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=52026
MAIL_USERNAME=
MAIL_PASSWORD=
# Anfuehrungszeichen noetig, sobald Leerzeichen im Wert stehen.
MAIL_FROM_ADDRESS="noreply@localhost"
MAIL_FROM_NAME="${APP_NAME}"

# --- Lernen ----------------------------------------------------------------
# Kalendertag fuer Faelligkeiten. Karten werden um Mitternacht dieser Zeitzone
# faellig, nicht um Mitternacht UTC.
LEARNING_TIMEZONE=Europe/Berlin

# --- Deploy-Hook (nur fuer Webspace ohne Kommandozeile) ----------------------
# deploy.sh ruft nach dem FTP-Upload POST /api/v1/deploy auf, um die Datenbank
# zu migrieren. Leer = Adresse gibt es nicht (404). Mindestens 32 Zeichen,
# erzeugen mit:  openssl rand -hex 32
DEPLOY_HOOK_TOKEN=

# --- Erinnerungen (Web-Push) ------------------------------------------------
# Taegliche Mitteilung an Geraete, die das unter „Mein Konto“ eingeschaltet
# haben. Schluessel erzeugen mit:  php artisan push:keys
# Ohne beide Schluessel ist die Funktion aus.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Kontakt fuer die Push-Dienste, z. B. "mailto:admin@example.com" (Vorgabe: APP_URL)
VAPID_SUBJECT=
# Geheimnis fuer POST /api/v1/reminders/run (Kopf X-Cron-Token), aufgerufen
# alle 15 Minuten von Cronicle, cron-job.org o. Ae. Leer = Adresse gibt es
# nicht (404). Mindestens 32 Zeichen:  openssl rand -hex 32
REMINDER_TOKEN=

# --- Update-Pruefung ---------------------------------------------------------
# Rohdatei des eigenen CHANGELOG.md. Ist sie gesetzt, vergleicht die Anwendung
# hoechstens einmal taeglich die eigene Version mit dieser Datei und zeigt
# Administratoren unter System neuere Eintraege an. Heruntergeladen oder
# installiert wird nichts.
#
# Leer oder nicht gesetzt = abgeschaltet, kein Netzzugriff. Das ist die Vorgabe.
# Fuer Cardbox:
#   UPDATE_CHECK_URL=https://raw.githubusercontent.com/kleineLoesungen/cardbox/main/CHANGELOG.md
UPDATE_CHECK_URL=

# --- Protokoll ---------------------------------------------------------------
# stderr statt Datei: Im Container landet es so in `docker logs`.
LOG_CHANNEL=stderr
LOG_LEVEL=debug
