<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:dGVzdHNjaGx1ZXNzZWwtbnVyLWZ1ZXItZGllLXRlc3Q="/>
        <env name="APP_URL" value="http://localhost:8000"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
          Echte Postgres statt SQLite: ILIKE, Check-Constraints und JSONB
          verhalten sich in SQLite anders. Ein Test, der gegen SQLite gruen
          ist, beweist fuer den Betrieb wenig.
          Eigene Datenbank starter_test — die Entwicklungsdaten bleiben stehen.
        -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="starter_test"/>
        <env name="DB_URL" value=""/>
        <!-- Argon2 absichtlich billig, sonst dauert jeder Test mit Passwort ~100 ms. -->
        <env name="HASH_DRIVER" value="argon2id"/>
        <env name="ARGON_MEMORY" value="1024"/>
        <env name="ARGON_TIME" value="1"/>
        <env name="ARGON_THREADS" value="1"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TRUST_PROXY" value="false"/>
        <env name="LOG_CHANNEL" value="null"/>
    </php>
</phpunit>
