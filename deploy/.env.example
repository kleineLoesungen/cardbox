# Cardbox – Einstellungen für den Server.
# Kopieren nach deploy/.env und ausfüllen:  cp .env.example .env && chmod 600 .env
# Werte ohne Anführungszeichen und ohne Leerzeichen eintragen.

# Adresse, unter der Cardbox erreichbar ist. Der DNS-Eintrag muss auf diesen
# Server zeigen. Ohne https:// davor.
CARDBOX_DOMAIN=cardbox.example.com

# Geheimer Schlüssel. Einmal erzeugen und nie wieder ändern (sonst sind alle
# abgemeldet):  echo "base64:$(openssl rand -base64 32)"
APP_KEY=

# Datenbank. Das Passwort einmal erzeugen:  openssl rand -hex 24
DB_DATABASE=cardbox
DB_USERNAME=cardbox
DB_PASSWORD=

# Name der App auf dem Startbildschirm.
APP_NAME=Cardbox
APP_SHORT_NAME=Cardbox

# Karten werden um Mitternacht dieser Zeitzone fällig.
LEARNING_TIMEZONE=Europe/Berlin

LOG_LEVEL=info

# Optional: Administratoren sehen unter System, wenn es eine neuere Version gibt.
# Die Instanz fragt dafür einmal täglich bei GitHub an. Leer = aus.
UPDATE_CHECK_URL=

# Optional: E-Mail. Cardbox schickt Benutzern keine Mails; gebraucht wird das
# nur für die Testmail unter System. Ohne Angabe landen Mails im Log.
MAIL_MAILER=log
# MAIL_MAILER=smtp
# MAIL_URL=smtps://benutzer:passwort@mail.example.com:465
# MAIL_FROM_ADDRESS=cardbox@example.com
# MAIL_FROM_NAME=Cardbox
