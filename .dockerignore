.git
.env
.env.*
!.env.example
# Patterns here only match at the root. deploy/ holds the server's own .env
# with passwords and APP_KEY — it must never end up inside the image.
**/.env
deploy/
.bin
vendor
node_modules
public/css/app.css
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php
.phpunit.cache
.DS_Store
