# Einstellungen für ./deploy.sh (Webspace mit FTP).
# Kopieren nach .env.deploy und ausfüllen. .env.deploy wird nie committet
# und nie hochgeladen. Kommentare mit #, Werte ohne Leerzeichen.

# FTP-Zugang vom Hoster
FTP_HOST=ftp.example.com
FTP_PORT=21
FTP_USER=
# Leer lassen, dann fragt deploy.sh jedes Mal (ohne Anzeige).
FTP_PASS=
# Ordner für Cardbox auf dem Webspace. Die Domain muss auf <FTP_DIR>/public zeigen.
FTP_DIR=cardbox
# Verschlüsselt übertragen (FTPS). Nur auf false setzen, wenn der Hoster kein
# FTPS kann – dann reisen Passwort und .env im Klartext.
FTP_SSL=true

# Adresse von Cardbox, mit https://
DEPLOY_URL=https://cardbox.example.com

# Geheimer Schlüssel für den Deploy-Hook. Derselbe Wert steht in
# .env.production. Erzeugen:  openssl rand -hex 32
DEPLOY_HOOK_TOKEN=

# Lokale Datei, die als .env auf den Server geladen wird (bei jedem Deploy).
DEPLOY_ENV_FILE=.env.production

# Nur zum Ausprobieren: just check überspringen / nicht committete Änderungen erlauben
# (hochgeladen wird trotzdem nur der letzte Commit).
DEPLOY_SKIP_CHECK=false
DEPLOY_ALLOW_DIRTY=false
